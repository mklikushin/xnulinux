+		    fp >= t->kernel_stack && fp < t->kernel_stack + kernel_stack_size; f++) {
+			uint64_t *frame = (uint64_t *)fp;
+			kprintf("linux64     frame 0x%llx\n", frame[1] | 0xffffff8000000000ULL);
+			fp = frame[0];
+		}
+	}
+}
