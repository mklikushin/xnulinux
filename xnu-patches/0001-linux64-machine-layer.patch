+			"msr	SPSel, #1"			"\n"
+			"mov	x1, %[pc]"			"\n"
+			"mov	w2, %w[cpsr]"			"\n"
+			"mov	x3, %[lr]"			"\n"
+			"mov	x4, %[x16]"			"\n"
+			"mov	x5, %[x17]"			"\n"
+			"str	x1, [x0, %[SS64_PC]]"		"\n"
+			"str	w2, [x0, %[SS64_CPSR]]"		"\n"
+			"str	x3, [x0, %[SS64_LR]]"		"\n"
+			"stp	x4, x5, [x0, %[SS64_X16]]"	"\n"
+			"bl	_ml_sign_thread_state"		"\n"
+			"msr	SPSel, x10"			"\n"
+			"mov	lr, x9"				"\n"
