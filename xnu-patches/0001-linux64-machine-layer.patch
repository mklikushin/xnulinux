+/* LINUX64: user-space exceptions by class for the host (linux64_abi.h, LINUX64_EL0_CLASSES) */
+uint64_t linux64_el0_stat[LINUX64_EL0_CPUS][2][LINUX64_EL0_CLASSES];
+static uint64_t linux64_el0_t0[LINUX64_EL0_CPUS];
+static uint8_t linux64_el0_cls[LINUX64_EL0_CPUS];
