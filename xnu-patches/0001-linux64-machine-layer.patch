+	(void)ml_set_interrupts_enabled(FALSE);
+	ast_taken_user();
+	if (linux64_svc_thread == thread && linux64_tracing()) {	/* what the system call returned (C set: x0 is errno) */
+		linux64_svc_thread = NULL;
+		extern int proc_selfpid(void);
