 /**
+ * Whether a scene is small enough for the thread that queues it to
+ * rasterize it itself.
+ *
+ * Handing a scene to the threads costs the same whatever is in it: a
+ * semaphore to wake each thread, two barriers they all meet at, a
+ * semaphore back from each.  A compositor draws a frame as dozens of
+ * render passes, most of them a few thousand pixels (an icon, a line of
+ * text, a level of a blur), and for those the hand-off is all of the time:
+ * 0.6 ms a pass with eight threads against 0.05 ms for the pixels.
+ *
+ * The estimate is the pixels the commands may touch: each command of a
+ * bin counts the bin's tile, cut to the framebuffer.  LP_INLINE_SCENE_PIXELS
+ * sets the limit, 0 hands every scene to the threads.
+ */
+static bool
+scene_is_small(struct lp_scene *scene)
+{
+   static int64_t limit = -1;
+   if (limit < 0)
+      limit = debug_get_num_option("LP_INLINE_SCENE_PIXELS", 32768);
+   if (limit == 0)
+      return false;
+
+   const unsigned samples = MAX2(1, scene->fb_max_samples);
+   int64_t pixels = 0;
+
+   for (unsigned y = 0; y < scene->tiles_y; y++) {
+      const unsigned top = y * TILE_SIZE;
+      const unsigned h = top < scene->fb.height ?
+         MIN2(TILE_SIZE, scene->fb.height - top) : 0;
+
+      for (unsigned x = 0; x < scene->tiles_x; x++) {
+         const unsigned left = x * TILE_SIZE;
+         const unsigned w = left < scene->fb.width ?
+            MIN2(TILE_SIZE, scene->fb.width - left) : 0;
+         const struct cmd_bin *bin = lp_scene_get_bin(scene, x, y);
+         unsigned cmds = 0;
+
+         for (const struct cmd_block *block = bin->head; block;
+              block = block->next) {
+            for (unsigned k = 0; k < block->count; k++) {
+               switch (block->cmd[k]) {
+               case LP_RAST_OP_SET_STATE:
+               case LP_RAST_OP_BEGIN_QUERY:
+               case LP_RAST_OP_END_QUERY:
+                  break;
+               default:
+                  cmds++;
+               }
+            }
+         }
+
+         pixels += (int64_t)cmds * w * h * samples;
+         if (pixels > limit)
+            return false;
+      }
+   }
+
+   return true;
+}
+
+
+/**
  * Called by setup module when it has something for us to render.
  */
 void
