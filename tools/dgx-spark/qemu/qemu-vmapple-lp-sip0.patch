+#define VMAPPLE_LP_SIP0_ENTRY (36u + 8u)
+static bool vmapple_find_asmb(uint8_t *tree, uint32_t size, uint32_t offset,
+                              int depth, bool *found, uint32_t *node,
+                              uint32_t *props_end, uint32_t *next)
+{
+    uint32_t properties, children, cursor, i;
+    bool is_asmb = false;
+    if (offset + 8 > size || depth > 128) {
+        return false;
+    }
+    properties = ldl_le_p(tree + offset);
+    children = ldl_le_p(tree + offset + 4);
+    cursor = offset + 8;
+    for (i = 0; i < properties; i++) {
+        const char *name;
+        uint32_t length, start;
+        if (cursor + 36 > size) {
+            return false;
+        }
+        name = (const char *)(tree + cursor);
+        length = ldl_le_p(tree + cursor + 32) & 0x00ffffffu;
+        start = cursor + 36;
+        if (start + length > size) {
+            return false;
+        }
+        if (!strcmp(name, "name") && length == 5 &&
+            !memcmp(tree + start, "asmb", 5)) {
+            is_asmb = true;
+        }
+        cursor = start + vmapple_align4(length);
+    }
+    if (is_asmb && !*found) {
+        *found = true;
+        *node = offset;
+        *props_end = cursor;
+    }
+    for (i = 0; i < children; i++) {
+        uint32_t child_next;
+        if (!vmapple_find_asmb(tree, size, cursor, depth + 1, found, node,
+                               props_end, &child_next)) {
+            return false;
+        }
+        cursor = child_next;
+    }
+    *next = cursor;
+    return true;
+}
+
+static void vmapple_insert_lp_sip0(uint64_t tree_pa, uint32_t tree_len,
+                                   uint64_t value)
+{
+    uint8_t *tree = g_malloc0(tree_len);
+    uint32_t node = 0, end = 0, next = 0;
+    bool found = false;
+    if (address_space_read(&address_space_memory, tree_pa,
+                           MEMTXATTRS_UNSPECIFIED, tree, tree_len) != MEMTX_OK) {
+        error_report("vmapple handoff: lp-sip0: cannot read the device tree");
+        goto out;
+    }
+    if (!vmapple_find_asmb(tree, tree_len, 0, 0, &found, &node, &end, &next) ||
+        !found || next + VMAPPLE_LP_SIP0_ENTRY > tree_len) {
+        error_report("vmapple handoff: lp-sip0: /chosen/asmb not found or no "
+                     "room (found %d, tree ends at 0x%x of 0x%x)", found, next, tree_len);
+        goto out;
+    }
+    memmove(tree + end + VMAPPLE_LP_SIP0_ENTRY, tree + end, next - end);
+    memset(tree + end, 0, VMAPPLE_LP_SIP0_ENTRY);
+    memcpy(tree + end, "lp-sip0", 7);
+    stl_le_p(tree + end + 32, 8);
+    stq_le_p(tree + end + 36, value);
+    stl_le_p(tree + node, ldl_le_p(tree + node) + 1);
+    address_space_write(&address_space_memory, tree_pa, MEMTXATTRS_UNSPECIFIED,
+                        tree, tree_len);
+    info_report("vmapple handoff: lp-sip0 = 0x%" PRIx64 " added to /chosen/asmb "
+                "(tree 0x%x of 0x%x bytes)", value, next + VMAPPLE_LP_SIP0_ENTRY, tree_len);
+out:
+    g_free(tree);
+}
+
 static bool vmapple_handoff_apply(CPUState *cs)
 {
     ARMCPU *cpu = ARM_CPU(cs);
@@ -1713,6 +1792,10 @@
     info_report("vmapple handoff: %d timebase properties set to %u Hz",
