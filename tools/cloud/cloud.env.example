# Settings for tools/cloud/*. Copy to tools/cloud/cloud.env (git ignores it) or point XNU_CLOUD_ENV at your copy.
# Plain shell assignments; values already set in the environment win. Nothing here is a secret: keys and the
# password stay in files you name.

# --- the cloud VM (the arm64 Linux host that runs the hosted macOS) ---
VM_HOST=${VM_HOST:-}                    # its address or DNS name. Empty: looked up with gcloud (GCP_INSTANCE, GCP_ZONE) and cached
VM_USER=${VM_USER:-$USER}               # your login on the VM
VM_KEY=${VM_KEY:-$HOME/.ssh/id_ed25519} # private key for that login
VM_REPO=${VM_REPO:-w/poc}               # this repository on the VM, relative to the VM home (scripts/vm-xnu-rebuild.sh expects ~/w/poc)
VM_IMAGE_DIR=${VM_IMAGE_DIR:-/var/tmp/macimg}   # where mac.img, mac.conf and trustcache.bin live on the VM
GCP_INSTANCE=${GCP_INSTANCE:-}          # only for the gcloud lookup of VM_HOST
GCP_ZONE=${GCP_ZONE:-}
GCLOUD=${GCLOUD:-gcloud}                # the gcloud binary (bucket relays and the lookup)

# --- the hosted macOS ---
GUEST_USER=${GUEST_USER:-xnu}           # the user tools/hosted/gui-user.py makes
GUEST_IP=${GUEST_IP:-}                  # empty: the newest lease of the VM's dnsmasq on xnu0
GUEST_KEY=${GUEST_KEY:-$HOME/.ssh/id_ed25519}   # key whose public half is in the guest's authorized_keys
GUEST_PASSWORD_FILE=${GUEST_PASSWORD_FILE:-}    # file holding the guest user's password on one line, mode 600. Never echoed.
GUEST_SCREEN=${GUEST_SCREEN:-1280x800}  # the hosted framebuffer's size

# --- the Mac that builds the disk (relay-mac-to-bucket.sh only) ---
MAC_HOST=${MAC_HOST:-}
MAC_USER=${MAC_USER:-}
MAC_KEY=${MAC_KEY:-$HOME/.ssh/id_ed25519}
MAC_BUILD_DIR=${MAC_BUILD_DIR:-xnubuild} # build folder on the Mac, relative to its home (mac/build-disk.sh uses ~/xnubuild)

# --- object storage (the two relay scripts and vm/pull-image.sh; Google Cloud Storage) ---
BUCKET=${BUCKET:-}                      # bucket name, no gs:// prefix
